{
  "name": "@kubeforge/mcp-servers",
  "version": "0.1.0",
  "private": true,
  "description": "@kubeforge/mcp-servers package of the Kubeforge workspace.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kubeforge-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node dist/stdio.js"
  },
  "dependencies": {
    "@kubeforge/mcp-tools": "workspace:*",
    "@kubeforge/helm": "workspace:*",
    "@kubeforge/kubernetes": "workspace:*",
    "@kubeforge/monitoring": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
